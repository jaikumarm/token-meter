#!/usr/bin/env python3
"""Antigravity PostInvocation hook: save model metadata, never conversation content."""
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from token_meter.runtimes.antigravity import record_model

try:
    raw = sys.stdin.buffer.read(64 * 1024 + 1)
    if len(raw) > 64 * 1024:
        raise ValueError('Hook payload exceeds limit')
    record_model(json.loads(raw))
except (ValueError, TypeError, OSError, UnicodeError, RecursionError):
    print('Token Meter: Gemini model metadata could not be recorded.', file=sys.stderr)
print('{}')
